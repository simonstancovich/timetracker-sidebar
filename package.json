{
  "name": "timetracker-sidebar",
  "version": "1.0.0",
  "description": "DevCore TimeTracker sidebar app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5180 && electron .\"",
    "build": "vite build && electron-builder"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "se.devcore.timetracker",
    "productName": "DevCore TimeTracker",
    "win": {
      "target": "nsis"
    }
  }
}
